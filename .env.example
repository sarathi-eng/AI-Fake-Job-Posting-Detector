# Backend (FastAPI)
# Use '*' only for local development.
APP_ENV=dev
CORS_ALLOW_ORIGINS=*
# Keep false unless you explicitly need cookies/auth sessions.
CORS_ALLOW_CREDENTIALS=false

# Frontend (Next.js)
# Used to build links to Swagger/health on the landing page.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
