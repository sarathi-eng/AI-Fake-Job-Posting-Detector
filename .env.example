# Backend (FastAPI)
# Use '*' only for local development.
APP_ENV=dev
CORS_ALLOW_ORIGINS=*
# Keep false unless you explicitly need cookies/auth sessions.
CORS_ALLOW_CREDENTIALS=false
COMPANY_REGISTRY_API_URL=https://api.opencorporates.com/v0.4/companies/search
# Optional OpenCorporates API token
COMPANY_REGISTRY_API_KEY=
MODEL_PATH=models/fake_job_classifier.joblib
MODEL_ENABLED=true
ENSEMBLE_RULE_WEIGHT=0.60
ENSEMBLE_ML_WEIGHT=0.40

# Frontend (Next.js)
# Used to build links to Swagger/health on the landing page.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
